# Selectel Resell API — ключи из my.selectel.ru → Профиль → Безопасность → API-ключи
SELECTEL_API_KEY_1=
SELECTEL_API_KEY_2=
# Single-account fallback (legacy)
SELECTEL_ACCOUNT_ID=
SELECTEL_API_KEY=
SELECTEL_PROJECT_ID=
# Resell API proxy rotation (round-robin, comma-separated)
RESELL_PROXY_URLS=   # socks5://u:p@1.2.3.4:1080,http://u:p@5.6.7.8:3128,...
# Deprecated (OpenStack service user — больше не используется)
# SELECTEL_PASSWORD_1=
# SELECTEL_PASSWORD_2=
# WLChecker API — comma-separated pool of API keys (preferred)
WL_API_KEYS=
# Legacy single-key var, still read by tests/test_wl_api.py
WLCHECKER_API_KEY=

# split branch: Samsung ping agent
VM_URL=             # http://<VM_IP>:8888
PING_AGENT_SECRET=  # одинаковый на VM и Samsung
PING_INTERFACE=rmnet0
PING_POLL_INTERVAL=2

# Telegram notifications
TG_BOT_TOKEN=
TG_CHAT_ID=
TG_PROXY_URL=  # socks5://127.0.0.1:10808
